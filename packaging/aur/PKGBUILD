# Maintainer: metalmike17 <michaeljg0717@gmail.com>
pkgname=termanim
pkgver=1.0.2
pkgrel=1
pkgdesc='Animated terminals for KDE Plasma: gravity drop, slingshot, glitch and more, plus a hotkey drop-down terminal'
arch=('any')
url='https://github.com/metalmike17/termanim'
license=('MIT')
depends=('kwin' 'kconfig' 'qt6-tools' 'python' 'python-gobject' 'gtk4' 'libadwaita')
optdepends=('ghostty: the hotkey drop-down terminal'
            'kscreen: lists your monitors in the settings window')
install=termanim.install
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('3040bccb5df343df6db15cb62688ff7683d8265ff2673c113731d9e0b1894dda')

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 bin/termanim "$pkgdir/usr/bin/termanim"
  install -Dm755 bin/termanim-settings "$pkgdir/usr/bin/termanim-settings"
  install -Dm644 termanim-settings.desktop "$pkgdir/usr/share/applications/termanim-settings.desktop"

  # the KWin script, in the system script directory
  install -d "$pkgdir/usr/share/kwin/scripts"
  cp -r kwin-script "$pkgdir/usr/share/kwin/scripts/termanim"

  install -Dm644 packaging/termanim-terminal.service "$pkgdir/usr/lib/systemd/user/termanim-terminal.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
