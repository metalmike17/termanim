[Unit]
Description=termanim hotkey terminal (a hidden Ghostty window)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/ghostty --class=dev.termanim.dropdown --gtk-single-instance=false --title="Drop-down Terminal"
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
